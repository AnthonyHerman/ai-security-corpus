// The site is plain static files (scripts/build-site.py -> _site/), served by Cloudflare Workers static assets.
// No Worker script: every request is an asset request, which the free plan serves without a request cap.
// Deployed by .github/workflows/pages.yml on every push to main.
{
  "name": "ai-security-corpus",
  "account_id": "0b24ef37228a5136e2a5627ac2889a2a",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "ai-security-corpus.online", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
